# Ajouter à ton .env existant. Conserver les valeurs DB et QR_SIGNING_SECRET existantes.
CHECKIN_USERS_FILE=./config/checkin-users.json
# SQLite existant : conserver DATABASE_PATH, démarrer depuis le dossier backend.
# MySQL existant : conserver DB_DRIVER=mysql et toutes les variables MYSQL_*.
# Hotel de l’evenement. L’agent ne saisit que le numero de chambre.
# Changer cette valeur et redemarrer suffit : aucune recompilation de l’app.
CHECKIN_DEFAULT_HOTEL=Hôtel Belvédère Ghardaïa
